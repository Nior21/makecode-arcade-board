# Copy to .env and fill. Never commit .env.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

TT_WORKER_HOST=127.0.0.1
TT_WORKER_PORT=9080
TT_BASE_URL=http://127.0.0.1:3100
TT_MCP_URL=http://127.0.0.1:3100/mcp

# RPI safety
TT_WORKER_MAX_QUEUE=2
TT_WORKER_MIN_MEM_KB=184320
TT_WORKER_TIMEOUT_MS=1500000
# Do not set TT_WORKER_WATCHDOG_MS below 600000 (10 min) — short values cause restart loops.

# Set 1 for webhook→queue→TT comments without calling Cursor SDK
# TT_WORKER_DRY_RUN=1
