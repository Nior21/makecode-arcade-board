# Webhook → локальный tt-agent-worker (:9080/hook).
# Копируется автоматически при первом запуске; можно править вручную.
TT_WEBHOOK_URL=http://127.0.0.1:9080/hook
TT_WEBHOOK_ASSIGNEE=AI_Agent
# TT_WEBHOOK_AUTH=Bearer ...   # только для Cursor cloud webhook
# TT_WEBHOOK_ENABLED=0         # отключить webhook без удаления URL
